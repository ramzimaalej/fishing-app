{
  "name": "castmate",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:free": "expo prebuild -p ios && (/usr/libexec/PlistBuddy -c 'Delete :aps-environment' ios/Castmate/Castmate.entitlements 2>/dev/null || true)",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-firebase/storage": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "date-fns": "^4.1.0",
    "expo": "^57.0.20",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.16",
    "expo-modules-core": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-splash-screen": "~57.0.4",
    "expo-system-ui": "~57.0.3",
    "i18next": "^26.3.6",
    "react": "^19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "^0.86.3",
    "react-native-ble-plx": "^3.2.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-iap": "^16.5.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-ble-plx|zustand))"
    ]
  },
  "private": true
}
