# Copy to `.env` and fill in. Loaded by app.config.ts at build time.
# NEVER commit the real .env — it is git-ignored.

# ---------------------------------------------------------------------------
# Monetization toggle. Defaults to FALSE: the revenue model is hardware-only, so
# the app ships with no paywall and every feature unlocked for everyone.
#
# Ads are not toggled — they were removed from the codebase entirely.
#
# With subscriptions off no IAP connection is opened, so the products need not
# exist in the stores yet.# ---------------------------------------------------------------------------
FEATURE_SUBSCRIPTIONS=false

# Google Sign-In (Web client ID from Firebase console > Authentication > Google)
GOOGLE_WEB_CLIENT_ID=

# Firebase native config files (paths). Generated from your Firebase project.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

# EAS build project id
EAS_PROJECT_ID=
