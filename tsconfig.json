{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // SDK 57's base config sets customConditions, which makes tsc follow the
    // "react-native" export condition into library *source*. Naming the global
    // type packages explicitly keeps jest/node globals available to those files
    // and to the test suite.
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@scan-foreground-service": [
        "./modules/scan-foreground-service"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
